{
  "manifest_version": 3,
  "name": "OpenSimplify - Job Application Autofill & AI Copilot",
  "version": "1.0.0",
  "description": "Free, privacy-first open-source job application autofill and in-tab AI copilot for Workday, Greenhouse, Lever, Ashby, and LinkedIn.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenSimplify Copilot",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon48.png", "icon128.png", "content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
