# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional. Enables cloud LLM access via OpenRouter (Claude 3.7 Sonnet, DeepSeek R1, GPT-4o, Llama 3.3).
# Configure this via the Secrets panel in the AI Studio UI.
OPENROUTER_API_KEY=

# ANTHROPIC_API_KEY: Optional. Enables direct access to Anthropic Claude Messages API (Claude 3.7 Sonnet, Claude 3.5 Sonnet/Haiku).
# Configure this via the Secrets panel in the AI Studio UI.
ANTHROPIC_API_KEY=

# OPENAI_API_KEY: Optional. Enables direct access to OpenAI models (GPT-4o, GPT-4o-mini, o3-mini).
# Configure this via the Secrets panel in the AI Studio UI.
OPENAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
